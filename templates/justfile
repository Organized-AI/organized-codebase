# Run `just` to see available recipes
# Run `just <recipe>` to execute a recipe

# Default recipe - show help
default:
    @just --list

# =============================================================================
# SCAFFOLDING RECIPES
# =============================================================================

# Scaffold .claude/ directory with agents, commands, hooks, skills
add-claude:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "📁 Creating .claude/ structure..."
    mkdir -p .claude/{agents,commands,hooks,skills}

    # Create settings.json if it doesn't exist
    if [ ! -f .claude/settings.json ]; then
        cat > .claude/settings.json << 'EOF'
    {
      "permissions": {
        "allow": [
          "Bash(git status)",
          "Bash(git diff:*)",
          "Bash(git log:*)",
          "Bash(npm run:*)",
          "Bash(npm test:*)",
          "Bash(npx:*)",
          "Bash(ls:*)",
          "Bash(cat:*)",
          "Bash(just:*)"
        ],
        "ask": [
          "Bash(git push:*)",
          "Bash(git commit:*)",
          "Bash(rm:*)",
          "Bash(npm install:*)"
        ],
        "deny": [
          "Bash(git push --force:*)",
          "Bash(git reset --hard:*)",
          "Bash(rm -rf /)",
          "Bash(sudo:*)"
        ]
      }
    }
    EOF
        echo "  ✅ Created .claude/settings.json"
    else
        echo "  ⏭️  .claude/settings.json already exists"
    fi

    # Create verify command
    if [ ! -f .claude/commands/verify.md ]; then
        cat > .claude/commands/verify.md << 'EOF'
    ---
    description: Run all verification checks (Boris methodology)
    ---

    # Verify Current Work

    Run verification suite:
    1. `git status` - check for uncommitted changes
    2. `npm run lint` - linting (if available)
    3. `npm run typecheck` - type checking (if TypeScript)
    4. `npm test` - run tests (if available)
    5. `npm run build` - build check (if available)

    Report Pass/Fail for each with specific errors.
    EOF
        echo "  ✅ Created .claude/commands/verify.md"
    fi

    # Create commit command
    if [ ! -f .claude/commands/commit.md ]; then
        cat > .claude/commands/commit.md << 'EOF'
    ---
    description: Smart commit with verification (Boris methodology)
    ---

    # Smart Commit

    1. Run /verify first
    2. Show `git status` and `git diff --stat`
    3. Generate conventional commit message (feat/fix/docs/refactor/test/chore)
    4. Ask for confirmation before committing
    5. Do NOT push unless explicitly requested
    EOF
        echo "  ✅ Created .claude/commands/commit.md"
    fi

    # Create review command
    if [ ! -f .claude/commands/review.md ]; then
        cat > .claude/commands/review.md << 'EOF'
    ---
    description: Self-review before PR (Boris methodology)
    ---

    # Self-Review

    1. Run `git diff main...HEAD`
    2. Check for: console.logs, commented code, TODOs, missing error handling
    3. Run full verification
    4. Provide recommendation: Ready / Needs Work
    EOF
        echo "  ✅ Created .claude/commands/review.md"
    fi

    # Create status command
    if [ ! -f .claude/commands/status.md ]; then
        cat > .claude/commands/status.md << 'EOF'
    ---
    description: Project health check (Boris methodology)
    ---

    # Project Status

    1. Git status and last 5 commits
    2. `npm outdated` for dependency health
    3. `npm test -- --coverage` for test coverage
    4. Build status
    5. Summary: Healthy / Needs Attention / Critical
    EOF
        echo "  ✅ Created .claude/commands/status.md"
    fi

    # Create verify-build agent
    if [ ! -f .claude/agents/verify-build.md ]; then
        cat > .claude/agents/verify-build.md << 'EOF'
    ---
    name: verify-build
    description: Validate builds work correctly from clean state
    ---

    # Build Validation Agent

    ## Checks
    1. Clean install: `rm -rf node_modules && npm ci`
    2. Build: `npm run build`
    3. Verify artifacts exist
    4. Smoke test: start app, check for crashes

    ## Output
    Build status, time, artifact sizes, warnings
    EOF
        echo "  ✅ Created .claude/agents/verify-build.md"
    fi

    # Create verify-architecture agent
    if [ ! -f .claude/agents/verify-architecture.md ]; then
        cat > .claude/agents/verify-architecture.md << 'EOF'
    ---
    name: verify-architecture
    description: Verify code follows architectural patterns and project conventions
    ---

    # Architecture Verification Agent

    ## Checks
    1. Files in correct directories
    2. No circular imports
    3. Layer boundaries respected
    4. Naming conventions followed

    ## Output
    - ✅ Passed checks
    - ⚠️ Warnings
    - ❌ Violations
    EOF
        echo "  ✅ Created .claude/agents/verify-architecture.md"
    fi

    echo "✅ .claude/ scaffolding complete!"

# Scaffold thin Codex adapter surface (optional)
add-codex:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "📁 Creating Codex adapter surface..."
    mkdir -p .codex/agents DOCUMENTATION

    if [ ! -f AGENTS.md ]; then
        cat > AGENTS.md << 'EOF'
    # AGENTS.md

    ## Organized Codebase — cross-harness operator brief

    Keep the core scaffold lean.
    - `CLAUDE.md` stays canonical
    - `AGENTS.md` stays short for Codex
    - `CONFIG/router/` owns routing policy
    - `harnesses/pi-agent/` owns local harness behavior

    Preserve Boris workflow: plan first, verify before commit, review before merge.
    EOF
        echo "  ✅ Created AGENTS.md"
    fi

    if [ ! -f .codex/config.toml ]; then
        cat > .codex/config.toml << 'EOF'
    #:schema https://developers.openai.com/codex/config-schema.json
    approval_policy = "on-request"
    sandbox_mode = "workspace-write"
    web_search = "cached"
    persistent_instructions = "Follow AGENTS.md and Boris verification-first workflow."

    [features]
    multi_agent = true

    [agents]
    max_threads = 4
    max_depth = 1

    [agents.explorer]
    description = "Read-only explorer for evidence gathering"
    config_file = "agents/explorer.toml"

    [agents.reviewer]
    description = "Reviewer focused on correctness and missing verification"
    config_file = "agents/reviewer.toml"

    [agents.docs_researcher]
    description = "Docs/API verification specialist"
    config_file = "agents/docs-researcher.toml"
    EOF
        echo "  ✅ Created .codex/config.toml"
    fi

    if [ ! -f .codex/agents/explorer.toml ]; then
        cat > .codex/agents/explorer.toml << 'EOF'
    model = "gpt-5-codex"
    model_reasoning_effort = "medium"
    sandbox_mode = "read-only"

    developer_instructions = """
    Stay in exploration mode. Cite files and symbols before proposing change.
    """
    EOF
        echo "  ✅ Created .codex/agents/explorer.toml"
    fi

    if [ ! -f .codex/agents/reviewer.toml ]; then
        cat > .codex/agents/reviewer.toml << 'EOF'
    model = "gpt-5-codex"
    model_reasoning_effort = "high"
    sandbox_mode = "read-only"

    developer_instructions = """
    Prioritize correctness, regressions, and missing verification.
    """
    EOF
        echo "  ✅ Created .codex/agents/reviewer.toml"
    fi

    if [ ! -f .codex/agents/docs-researcher.toml ]; then
        cat > .codex/agents/docs-researcher.toml << 'EOF'
    model = "gpt-5-codex"
    model_reasoning_effort = "medium"
    sandbox_mode = "read-only"

    developer_instructions = """
    Verify workflow claims against primary docs and repo files.
    """
    EOF
        echo "  ✅ Created .codex/agents/docs-researcher.toml"
    fi

    if [ ! -f DOCUMENTATION/CODEX-SETUP.md ]; then
        cat > DOCUMENTATION/CODEX-SETUP.md << 'EOF'
    # Codex Setup

    Add thin Codex support without importing an ECC-sized control plane.

    Use:
    - `AGENTS.md`
    - `.codex/config.toml`
    - `.codex/agents/*.toml`
    EOF
        echo "  ✅ Created DOCUMENTATION/CODEX-SETUP.md"
    fi

    if [ ! -f DOCUMENTATION/CODEX-VS-CLAUDE-SURFACE-MAP.md ]; then
        cat > DOCUMENTATION/CODEX-VS-CLAUDE-SURFACE-MAP.md << 'EOF'
    # Codex vs Claude Surface Map

    - `CLAUDE.md` = canonical project manual
    - `AGENTS.md` = thin Codex primer
    - `CONFIG/router/` = shared routing policy
    - `harnesses/pi-agent/` = shared local harness layer
    EOF
        echo "  ✅ Created DOCUMENTATION/CODEX-VS-CLAUDE-SURFACE-MAP.md"
    fi

    echo "✅ Codex scaffolding complete!"

# Create .ralphy/config.yaml for Ralphy integration
add-ralphy:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "📁 Creating .ralphy/ structure..."
    mkdir -p .ralphy

    if [ ! -f .ralphy/config.yaml ]; then
        cat > .ralphy/config.yaml << 'EOF'
    # Ralphy Configuration
    # https://github.com/ralphy

    version: "1.0"

    project:
      name: ""  # Set your project name
      description: ""

    agents:
      default_model: "claude-3-opus"
      max_turns: 50

    workflows:
      verify:
        - lint
        - test
        - build

      deploy:
        requires: [verify]
        steps:
          - build
          - deploy

    hooks:
      pre_commit:
        - just verify
      post_commit:
        - echo "Committed successfully"
    EOF
        echo "  ✅ Created .ralphy/config.yaml"
    else
        echo "  ⏭️  .ralphy/config.yaml already exists"
    fi

    echo "✅ Ralphy scaffolding complete!"

# Scaffold kata workflow enforcement (batteries + strict mode)
add-kata:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "📁 Setting up kata workflow enforcement..."

    # Check if kata is installed
    if ! npx kata --version &>/dev/null; then
        echo "  📦 Installing @codevibesmatter/kata..."
        npm install --save-dev @codevibesmatter/kata
    else
        echo "  ✅ kata already installed ($(npx kata --version))"
    fi

    # Run kata setup with batteries + strict hooks
    if [ ! -f .claude/workflows/kata.yaml ]; then
        echo "  🔧 Running kata setup --batteries --strict..."
        npx kata setup --batteries --strict
        echo "  ✅ kata configured with batteries + strict mode"
    else
        echo "  ⏭️  .claude/workflows/kata.yaml already exists"
        echo "  💡 Run 'npx kata batteries --update' to refresh templates"
    fi

    echo ""
    echo "✅ kata scaffolding complete!"
    echo ""
    echo "  Available modes:"
    echo "    kata enter planning        — Research, spec, review"
    echo "    kata enter implementation  — Execute approved specs"
    echo "    kata enter task            — Small changes"
    echo "    kata enter debug           — Systematic debugging"
    echo "    kata enter research        — Explore and synthesize"
    echo "    kata enter freeform        — Quick questions"
    echo ""
    echo "  Workflow: kata enter <mode> → work → kata can-exit → kata exit"

# Create PLANNING/ documentation structure
add-planning:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "📁 Creating PLANNING/ structure..."
    mkdir -p PLANNING/{implementation-phases,decisions,experiments}

    # Create README
    if [ ! -f PLANNING/README.md ]; then
        cat > PLANNING/README.md << 'EOF'
    # Planning Documentation

    This directory contains project planning artifacts.

    ## Structure

    ```
    PLANNING/
    ├── implementation-phases/  # Phased build prompts (PHASE-X-PROMPT.md)
    ├── decisions/              # Architecture Decision Records (ADRs)
    └── experiments/            # Experimental code and POCs
    ```

    ## Phased Build

    Use `PHASE-X-PROMPT.md` files for structured implementation:

    1. `PHASE-0-PROMPT.md` - Project bootstrap
    2. `PHASE-1-PROMPT.md` - Core implementation
    3. `PHASE-2-PROMPT.md` - Features
    4. etc.

    Run phases with: `/phased-build`
    EOF
        echo "  ✅ Created PLANNING/README.md"
    fi

    # Create PHASE-0 template
    if [ ! -f PLANNING/implementation-phases/PHASE-0-PROMPT.md ]; then
        cat > PLANNING/implementation-phases/PHASE-0-PROMPT.md << 'EOF'
    # Phase 0: Project Bootstrap

    ## Objective
    Set up the foundational project structure and tooling.

    ## Prerequisites
    - Node.js 20+
    - Git initialized

    ## Tasks

    ### 1. Initialize Package
    ```bash
    npm init -y
    ```

    ### 2. Install Dependencies
    ```bash
    npm install typescript @types/node --save-dev
    ```

    ### 3. Configure TypeScript
    Create `tsconfig.json` with strict mode.

    ### 4. Set Up Linting
    ```bash
    npm install eslint @typescript-eslint/parser @typescript-eslint/eslint-plugin --save-dev
    ```

    ## Verification
    - [ ] `npm run build` succeeds
    - [ ] `npm run lint` passes
    - [ ] Project structure matches CLAUDE.md

    ## Next Phase
    Proceed to PHASE-1 for core implementation.
    EOF
        echo "  ✅ Created PLANNING/implementation-phases/PHASE-0-PROMPT.md"
    fi

    echo "✅ PLANNING/ scaffolding complete!"

# Create AGENT-HANDOFF/ directory for context transfer
add-handoff:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "📁 Creating AGENT-HANDOFF/ structure..."
    mkdir -p AGENT-HANDOFF

    if [ ! -f AGENT-HANDOFF/HANDOFF.md ]; then
        cat > AGENT-HANDOFF/HANDOFF.md << 'EOF'
    # Agent Handoff Document

    ## Project: [PROJECT_NAME]

    ### Quick Context
    [1-2 sentence description of what this project does]

    ### Key Files to Read
    1. `CLAUDE.md` - Project overview and conventions
    2. `DOCUMENTATION/` - Technical documentation
    3. `PLANNING/` - Implementation phases

    ### Current State

    | Component | Status |
    |-----------|--------|
    | Core Framework | ⏳ In Progress |
    | Tests | ⏳ Not Started |
    | Documentation | ⏳ Not Started |

    ### Recent Changes
    - [Date]: [Change description]

    ### Blocked On
    - [Any blockers or pending decisions]

    ### Next Steps
    1. [Next immediate task]
    2. [Following task]

    ### Known Issues
    - [Issue 1]
    - [Issue 2]

    ### Environment Setup
    ```bash
    npm install
    npm run build
    npm test
    ```
    EOF
        echo "  ✅ Created AGENT-HANDOFF/HANDOFF.md"
    fi

    if [ ! -f AGENT-HANDOFF/CONTEXT-WINDOW.md ]; then
        cat > AGENT-HANDOFF/CONTEXT-WINDOW.md << 'EOF'
    # Context Window State

    Last updated: [TIMESTAMP]

    ## Session Summary
    [What was accomplished in the last session]

    ## Files Modified
    - `path/to/file1.ts` - [brief description]
    - `path/to/file2.ts` - [brief description]

    ## Decisions Made
    - [Decision 1]: [Rationale]
    - [Decision 2]: [Rationale]

    ## Questions for Next Session
    - [ ] [Question 1]
    - [ ] [Question 2]

    ## Token Budget Notes
    - Estimated tokens used: X
    - Remaining budget: Y
    EOF
        echo "  ✅ Created AGENT-HANDOFF/CONTEXT-WINDOW.md"
    fi

    echo "✅ AGENT-HANDOFF/ scaffolding complete!"

# Scaffold Organized Router policy surface (optional)
add-organized-router:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "📁 Creating Organized Router policy surface..."
    mkdir -p CONFIG/router DOCUMENTATION

    if [ ! -f CONFIG/router/README.md ]; then
        cat > CONFIG/router/README.md << 'EOF'
    # Organized Router

    Keep routing policy separate from the core scaffold.
    Route by task class, privacy boundary, verification burden, and cost ceiling.
    EOF
        echo "  ✅ Created CONFIG/router/README.md"
    fi

    if [ ! -f CONFIG/router/task-classes.json ]; then
        cat > CONFIG/router/task-classes.json << 'EOF'
    {
      "version": "1",
      "aliases": {
        "code-analysis": "review",
        "code-generation": "codegen",
        "refactoring": "codegen",
        "simple-edit": "artifact-polish"
      },
      "classes": {
        "summarize": {"defaultPolicy": "local-first"},
        "classify": {"defaultPolicy": "local-first"},
        "plan": {"defaultPolicy": "balanced"},
        "codegen": {"defaultPolicy": "balanced"},
        "review": {"defaultPolicy": "quality"},
        "verify": {"defaultPolicy": "balanced"},
        "research": {"defaultPolicy": "balanced"},
        "artifact-polish": {"defaultPolicy": "local-first"}
      }
    }
    EOF
        echo "  ✅ Created CONFIG/router/task-classes.json"
    fi

    if [ ! -f CONFIG/router/route-policies.json ]; then
        cat > CONFIG/router/route-policies.json << 'EOF'
    {
      "version": "1",
      "defaults": {"policy": "balanced", "privacy": "standard"},
      "policies": {
        "balanced": {"description": "local first pass, strong remote judgment when needed"},
        "local-first": {"description": "prefer local routes until ambiguity forces escalation"},
        "quality": {"description": "bias toward stronger frontier reasoning"},
        "private-first": {"description": "keep work local unless approved otherwise"},
        "budget-first": {"description": "minimize cost; escalate narrowly"}
      }
    }
    EOF
        echo "  ✅ Created CONFIG/router/route-policies.json"
    fi

    if [ ! -f CONFIG/router/model-manifests.json ]; then
        cat > CONFIG/router/model-manifests.json << 'EOF'
    {
      "version": "1",
      "models": {
        "qwen3:8b": {"family": "local"},
        "gemma-4-e4b-it-Q4_K_M": {"family": "local"},
        "claude-sonnet-4": {"family": "frontier"},
        "claude-opus-4-20250514": {"family": "frontier"},
        "gpt-5-codex": {"family": "frontier"}
      }
    }
    EOF
        echo "  ✅ Created CONFIG/router/model-manifests.json"
    fi

    if [ ! -f DOCUMENTATION/ORGANIZED-ROUTER.md ]; then
        cat > DOCUMENTATION/ORGANIZED-ROUTER.md << 'EOF'
    # Organized Router

    Router is separate from both Claude and Codex harness surfaces.
    Use it to decide when work stays local, when it goes to Claude, and when it goes to Codex.
    EOF
        echo "  ✅ Created DOCUMENTATION/ORGANIZED-ROUTER.md"
    fi

    echo "✅ Organized Router scaffolding complete!"

# Scaffold Pi/local harness companion surface (optional)
add-pi-harness-companion:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "📁 Creating Pi/local harness companion surface..."
    mkdir -p harnesses/pi-agent DOCUMENTATION scripts

    if [ ! -f harnesses/pi-agent/frontier-pairings.json ]; then
        cat > harnesses/pi-agent/frontier-pairings.json << 'EOF'
    {
      "version": "1",
      "pairings": [
        {"name": "claude-sonnet4-qwen3-8b", "frontier": "claude-sonnet-4", "local": "qwen3:8b"},
        {"name": "claude-opus4-gemma4-fable", "frontier": "claude-opus-4-20250514", "local": "gemma-4-e4b-it-Q4_K_M"},
        {"name": "gpt5-codex-qwen3-8b", "frontier": "gpt-5-codex", "local": "qwen3:8b"}
      ]
    }
    EOF
        echo "  ✅ Created harnesses/pi-agent/frontier-pairings.json"
    fi

    if [ ! -f DOCUMENTATION/PI-AGENT-HARNESS-COMPANION.md ]; then
        cat > DOCUMENTATION/PI-AGENT-HARNESS-COMPANION.md << 'EOF'
    # Pi Agent Harness Companion

    Keep local/frontier sibling harnesses separate from the core scaffold and separate from Organized Router.
    EOF
        echo "  ✅ Created DOCUMENTATION/PI-AGENT-HARNESS-COMPANION.md"
    fi

    if [ ! -f scripts/scaffold-pi-harness.js ]; then
        cat > scripts/scaffold-pi-harness.js << 'EOF'
    #!/usr/bin/env node
    const fs = require('fs');
    const path = require('path');
    const args = Object.fromEntries(process.argv.slice(2).map((v, i, arr) => v.startsWith('--') ? [v.slice(2), arr[i + 1] && !arr[i + 1].startsWith('--') ? arr[i + 1] : true] : null).filter(Boolean));
    if (!args.name || !args.frontier || !args.local) {
      console.log('Usage: node scripts/scaffold-pi-harness.js --name <name> --frontier <frontier-model> --local <local-model>');
      process.exit(1);
    }
    const slug = String(args.name).trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const base = path.join(process.cwd(), 'harnesses', slug);
    if (fs.existsSync(base)) {
      console.error(`Harness already exists: ${base}`);
      process.exit(1);
    }
    fs.mkdirSync(path.join(base, 'agents'), { recursive: true });
    fs.mkdirSync(path.join(base, 'tasks'), { recursive: true });
    fs.mkdirSync(path.join(base, 'runs'), { recursive: true });
    fs.mkdirSync(path.join(base, 'logs'), { recursive: true });
    fs.writeFileSync(path.join(base, 'harness.json'), JSON.stringify({ name: slug, frontierModel: args.frontier, localModel: args.local }, null, 2) + '\n');
    fs.writeFileSync(path.join(base, 'agents', 'orchestrator.md'), `# ${slug} orchestrator\n\nPreserve the frontier parent's task shape and escalate when local confidence is low.\n`);
    fs.writeFileSync(path.join(base, 'agents', 'worker.md'), `# ${slug} worker\n\nLocal ${args.local} worker. Emit bounded JSON and cite evidence.\n`);
    fs.writeFileSync(path.join(base, 'agents', 'verifier.md'), `# ${slug} verifier\n\nReject outputs that violate the JSON contract or skip escalation.\n`);
    fs.writeFileSync(path.join(base, 'tasks', 'task_packet.template.json'), JSON.stringify({ frontier_parent: args.frontier, local_worker: args.local, acceptance: ['return bounded JSON', 'cite evidence', 'state escalation reason if needed'] }, null, 2) + '\n');
    fs.writeFileSync(path.join(base, 'README.md'), `# ${slug}\n\nFrontier parent: ${args.frontier}\nLocal worker: ${args.local}\n`);
    console.log(base);
    EOF
        chmod +x scripts/scaffold-pi-harness.js
        echo "  ✅ Created scripts/scaffold-pi-harness.js"
    fi

    echo "✅ Pi/local harness scaffolding complete!"

# Scaffold Herdr post-bootstrap tool standing-up standard (optional)
add-herdr-tool-standup:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "📁 Creating Herdr tool stand-up standard..."
    mkdir -p DOCUMENTATION

    if [ ! -f DOCUMENTATION/HERDR-TOOL-STANDUP.md ]; then
        cat > DOCUMENTATION/HERDR-TOOL-STANDUP.md << 'EOF'
    # Herdr Tool Stand-Up Standard

    Standardize tool standing-up **after** the repo is bootstrapped and the Herdr session already exists.

    Order:
    1. Bootstrap repo
    2. Bootstrap Herdr session / pane
    3. Start the target agent
    4. Stand up only the tools/plugins that agent actually needs

    Claude Code baseline inside Herdr:
    - `/plugin marketplace add Organized-AI/plugin-marketplace`
    - `/plugin install boris@organized-ai-marketplace`
    - `/plugin install phased-planning@organized-ai-marketplace`

    Hermes baseline inside Herdr:
    - `hermes tools enable terminal`
    - `hermes tools enable file`
    - `hermes tools enable skills`
    - `hermes tools enable session_search`
    - `hermes tools enable delegation`

    Codex baseline inside Herdr:
    - rely on `AGENTS.md`
    - rely on `.codex/config.toml`
    - use `.codex/agents/*.toml`

    Keep tool standing-up task-driven. Do not install everything by default.
    EOF
        echo "  ✅ Created DOCUMENTATION/HERDR-TOOL-STANDUP.md"
    fi

    echo "✅ Herdr tool stand-up scaffolding complete!"

# =============================================================================
# MAIN RECIPE - Apply all scaffolding
# =============================================================================

# Apply complete Organized Codebase structure
apply-organized: add-claude add-kata add-ralphy add-planning add-handoff
    #!/usr/bin/env bash
    set -euo pipefail
    echo ""
    echo "📁 Creating additional directories..."
    mkdir -p ARCHITECTURE DOCUMENTATION SPECIFICATIONS CONFIG scripts .archive

    # Create CLAUDE.md if it doesn't exist
    if [ ! -f CLAUDE.md ]; then
        cat > CLAUDE.md << 'EOF'
    # [Project Name]

    Brief description of your project.

    ## Tech Stack
    - Runtime: Node.js 20+
    - Languages: TypeScript
    - Key Dependencies: [list major packages]

    ## Project Structure
    ```
    .claude/           → Claude Code config (agents, commands, hooks, skills)
    PLANNING/          → Implementation phases and planning docs
    ARCHITECTURE/      → System design documentation
    DOCUMENTATION/     → General docs and guides
    SPECIFICATIONS/    → Functional/technical specs
    AGENT-HANDOFF/     → Context transfer between sessions
    CONFIG/            → Configuration files
    scripts/           → Automation scripts
    ```

    ## Code Conventions
    - Use TypeScript with strict mode
    - Prefer async/await over callbacks
    - Use conventional commits (feat/fix/docs/refactor/test/chore)

    ## DO NOT
    - Never use `--dangerously-skip-permissions`
    - Never skip plan mode for complex features
    - Never commit without running verification first

    ## Verification Requirements
    Before completing ANY task:
    1. Describe your verification approach
    2. Run `npm test` and `npm run lint`
    3. For UI changes: provide screenshot
    EOF
        echo "  ✅ Created CLAUDE.md"
    fi

    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "  ✅ ORGANIZED CODEBASE STRUCTURE APPLIED!"
    echo "═══════════════════════════════════════════════════════════════"
