{
  "version": "1",
  "defaults": {
    "policy": "balanced",
    "privacy": "standard"
  },
  "policies": {
    "balanced": {
      "description": "Use local models for cheap first passes; route to strong harnesses for judgment-heavy work."
    },
    "local-first": {
      "description": "Prefer local/Pi routes until verification burden or ambiguity forces escalation."
    },
    "quality": {
      "description": "Bias toward frontier-quality reasoning and stronger review surfaces."
    },
    "private-first": {
      "description": "Keep work local unless the user explicitly approves remote escalation."
    },
    "budget-first": {
      "description": "Minimize cost; reserve frontier routes for a narrow final pass."
    }
  },
